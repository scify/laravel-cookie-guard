{
  "name": "laravel-cookie-guard",
  "version": "5.0.2",
  "description": "GDPR-compliant cookie consent dialog for Laravel applications.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "dev": "vite",
    "build": "vite build && cp resources/styles/_variables.css public/_variables.css",
    "lint": "eslint resources",
    "lint:fix": "eslint --fix resources",
    "format": "prettier --write \"resources/\"",
    "lint:styles": "stylelint './resources/**/*.css' './resources/**/*.scss'",
    "lint:styles:fix": "stylelint './resources/**/*.css' './resources/**/*.scss' --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scify/laravel-cookie-guard.git"
  },
  "keywords": [],
  "author": "SciFY",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scify/laravel-cookie-guard/issues"
  },
  "homepage": "https://github.com/scify/laravel-cookie-guard#readme",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "blade-formatter": "^1.44.4",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "stylelint": "^17.15",
    "stylelint-config-standard-scss": "^17.0",
    "stylelint-prettier": "^5.0",
    "vite": "^8.2.2"
  }
}
